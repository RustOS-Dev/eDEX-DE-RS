[Unit]
Description=eDEX-DE desktop shell
Documentation=https://github.com/eDEX-OS/eDEX-DE
PartOf=graphical-session.target
After=graphical-session-pre.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/edex-de run
Restart=on-failure
RestartSec=1
Environment=RUST_LOG=info
Slice=session.slice
