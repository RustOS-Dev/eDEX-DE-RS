#!/bin/sh
set -e
case "$1" in
    configure)
        systemd-tmpfiles --create edex-greeter.conf >/dev/null 2>&1 || true
        cat <<'MSG'
eDEX-DE installed. Choose "eDEX-DE" in your display manager, or enable the eDEX greeter:
  sudo cp /usr/share/edex-de/greetd/config.toml /etc/greetd/config.toml && sudo systemctl enable greetd
MSG
        ;;
esac
exit 0
