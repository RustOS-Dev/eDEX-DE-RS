post_install() {
    cat <<'MSG'
==> eDEX-DE installed.

    Log in from any display manager by choosing "eDEX-DE", or use the eDEX greeter:

      sudo cp /usr/share/edex-de/greetd/config.toml /etc/greetd/config.toml
      sudo systemctl enable greetd.service

    The shell config lives in ~/.config/edex-de/config.toml (created on first start);
    Hyprland reads /usr/share/edex-de/hypr/*.lua plus ~/.config/hypr/user.lua.
MSG
}

post_upgrade() {
    systemd-tmpfiles --create edex-greeter.conf >/dev/null 2>&1 || true
}
