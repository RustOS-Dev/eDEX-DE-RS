#!/bin/sh
# edex-tor-mode off|socks5 — switch Tor for eDEX-DE on RustOS.
#
# socks5 enables and starts the `tor` service (RustOS svc) with a SOCKS port on 127.0.0.1:9050
# and a cookie-authenticated control port on 127.0.0.1:9051; off stops and disables it. Tor's
# configuration, bridges and the recorded mode (`edex-mode`, read by the Privacy panel) live in
# /storage/etc/tor, or /etc/tor on a system without a storage partition. RustOS has no packet
# filter, so there is no transparent mode.
set -eu

mode=${1:-}
dir=/etc/tor
data=/var/lib/tor
if [ -d /storage/etc ]; then
    dir=/storage/etc/tor
    data=/storage/var/lib/tor
fi

# GeoIP files from the RustOS tor port (/usr/local/share/tor), else a system Tor's.
share=/usr/local/share/tor
[ -r "$share/geoip" ] || share=/usr/share/tor

write_torrc() {
    mkdir -p "$dir/torrc.d" /run/tor "$data"
    chmod 700 "$data"
    cat > "$dir/torrc" <<CONF
# Written by edex-tor-mode. Bridges live in $dir/torrc.d/40-bridges.conf.
SocksPort 127.0.0.1:9050
ControlPort 127.0.0.1:9051
CookieAuthentication 1
CookieAuthFile /run/tor/control.authcookie
CookieAuthFileGroupReadable 1
DataDirectory $data
GeoIPFile $share/geoip
GeoIPv6File $share/geoip6
%include $dir/torrc.d/*.conf
CONF
}

case "$mode" in
    socks5)
        write_torrc
        svc enable tor >/dev/null
        svc restart tor >/dev/null 2>&1 || svc start tor >/dev/null
        ;;
    off)
        svc stop tor >/dev/null 2>&1 || true
        svc disable tor >/dev/null 2>&1 || true
        ;;
    *)
        echo "usage: edex-tor-mode off|socks5" >&2
        exit 2
        ;;
esac
mkdir -p "$dir"
echo "$mode" > "$dir/edex-mode"
