---
source: settings/src/labwc_export.rs
expression: render_rc_xml(&c)
---
<?xml version="1.0"?>
<!-- Generated by eDEX-DE settings (Settings → Window manager). Do not edit:
     changes are overwritten. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>8</gap>
  </core>
  <theme>
    <maximizedDecoration>none</maximizedDecoration>
    <cornerRadius>0</cornerRadius>
    <font><name>JetBrainsMono Nerd Font</name><size>10</size></font>
  </theme>
  <desktops number="1" />
  <margin top="8" bottom="8" left="8" right="8" />
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>
  <placement>
    <policy>center</policy>
  </placement>
  <keyboard>
    <repeatRate>30</repeatRate>
    <repeatDelay>300</repeatDelay>
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="edex-de ipc toggle launcher" /></keybind>
    <keybind key="W-space"><action name="Execute" command="edex-de ipc toggle launcher" /></keybind>
    <keybind key="W-comma"><action name="Execute" command="edex-de ipc toggle settings" /></keybind>
    <keybind key="W-p"><action name="Execute" command="edex-de ipc toggle privacy" /></keybind>
    <keybind key="W-n"><action name="Execute" command="edex-de ipc toggle notifications" /></keybind>
    <keybind key="W-Escape"><action name="Execute" command="edex-de ipc toggle power" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="edex-de ipc focus terminal" /></keybind>
    <keybind key="W-F1"><action name="Execute" command="edex-de ipc focus filesystem" /></keybind>
    <keybind key="W-S-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="W-S-q"><action name="Kill" /></keybind>
    <keybind key="W-f"><action name="Execute" command="edex-de ipc action maximize" /></keybind>
    <keybind key="W-S-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-m"><action name="Iconify" /></keybind>
    <keybind key="W-C-f"><action name="Execute" command="edex-de ipc action side-panels" /></keybind>
    <keybind key="W-v"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-Tab"><action name="NextWindow" /></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-S-r"><action name="Reconfigure" /><action name="Execute" command="edex-de ipc reload" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="edex-de ipc audio volume +5" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="edex-de ipc audio volume -5" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="edex-de ipc audio mute" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="edex-de ipc audio mic-mute" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="edex-de ipc brightness +10" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="edex-de ipc brightness -10" /></keybind>
    <keybind key="W-S-Left"><action name="MoveToEdge" direction="left" /></keybind>
    <keybind key="W-S-Right"><action name="MoveToEdge" direction="right" /></keybind>
    <keybind key="W-S-Up"><action name="MoveToEdge" direction="up" /></keybind>
    <keybind key="W-S-Down"><action name="MoveToEdge" direction="down" /></keybind>
  </keyboard>
  <mouse>
    <default />
  </mouse>
  <libinput>
    <device category="default">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <pointerSpeed>0.00</pointerSpeed>
    </device>
  </libinput>
  <windowRules>
    <windowRule identifier="*" type="normal">
      <action name="Maximize" />
    </windowRule>
  </windowRules>
</labwc_config>
